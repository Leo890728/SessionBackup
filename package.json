{
  "name": "session-backup",
  "displayName": "AI Session Backup",
  "description": "以 append-only 格式備份並跨電腦合併 Claude Code 與 Codex session",
  "version": "1.1.1",
  "publisher": "lin24362525",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leo890728/SessionBackup.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sessionBackup.backupNow",
        "title": "Session Backup: 立即備份"
      },
      {
        "command": "sessionBackup.sync",
        "title": "Session Backup: 同步並合併其他電腦紀錄..."
      },
      {
        "command": "sessionBackup.manageProjects",
        "title": "Session Backup: 管理 Claude 專案對應..."
      },
      {
        "command": "sessionBackup.manageSelection",
        "title": "Session Backup: 管理追蹤的對話..."
      },
      {
        "command": "sessionBackup.mapProject",
        "title": "對應到本機資料夾",
        "icon": "$(link)"
      },
      {
        "command": "sessionBackup.includeSession",
        "title": "納入追蹤",
        "icon": "$(check)"
      },
      {
        "command": "sessionBackup.excludeSession",
        "title": "取消追蹤",
        "icon": "$(circle-slash)"
      },
      {
        "command": "sessionBackup.setupRemote",
        "title": "Session Backup: 連接備份儲存庫"
      },
      {
        "command": "sessionBackup.reconnectRemote",
        "title": "Session Backup: 重新連接備份儲存庫",
        "icon": "$(repo)"
      },
      {
        "command": "sessionBackup.signInGithub",
        "title": "Session Backup: 重新登入 GitHub"
      },
      {
        "command": "sessionBackup.publishGithub",
        "title": "Session Backup: 備份至遠端儲存庫"
      },
      {
        "command": "sessionBackup.refreshRepository",
        "title": "重新整理 GitHub 備份狀態",
        "icon": "$(refresh)"
      },
      {
        "command": "sessionBackup.repositoryViewAsTree",
        "title": "樹狀顯示"
      },
      {
        "command": "sessionBackup.repositoryViewAsList",
        "title": "清單顯示"
      },
      {
        "command": "sessionBackup.resolveConflict",
        "title": "解決 Session 衝突..."
      },
      {
        "command": "sessionBackup.openRepo",
        "title": "Session Backup: 開啟本地備份儲存庫資料夾"
      },
      {
        "command": "sessionBackup.showLog",
        "title": "Session Backup: 顯示記錄"
      },
      {
        "command": "sessionBackup.debug.deleteRemoteRepository",
        "title": "Session Backup: [除錯] 刪除遠端備份儲存庫"
      },
      {
        "command": "sessionBackup.debug.signOutGithub",
        "title": "Session Backup: [除錯] 登出 GitHub"
      },
      {
        "command": "sessionBackup.debug.deleteLocalData",
        "title": "Session Backup: [除錯] 刪除本機備份資料"
      },
      {
        "command": "sessionBackup.refreshSessions",
        "title": "重新整理",
        "icon": "$(refresh)"
      },
      {
        "command": "sessionBackup.previewSession",
        "title": "預覽對話"
      },
      {
        "command": "sessionBackup.openConversation",
        "title": "在對話開啟",
        "icon": {
          "light": "media/light/open-in-chat.svg",
          "dark": "media/dark/open-in-chat.svg"
        }
      },
      {
        "command": "sessionBackup.exportSession",
        "title": "匯出 Markdown"
      },
      {
        "command": "sessionBackup.openSessionFile",
        "title": "開啟原始 JSONL"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionBackup",
          "title": "Session Backup",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sessionBackup": [
        {
          "id": "sessionBackup.repository",
          "name": "GitHub Backup"
        },
        {
          "id": "sessionBackup.sessions",
          "name": "Sessions"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sessionBackup.refreshRepository",
          "when": "view == sessionBackup.repository",
          "group": "navigation"
        },
        {
          "command": "sessionBackup.repositoryViewAsTree",
          "when": "view == sessionBackup.repository && !sessionBackup.repositoryTreeView",
          "group": "1_view@1"
        },
        {
          "command": "sessionBackup.repositoryViewAsList",
          "when": "view == sessionBackup.repository && sessionBackup.repositoryTreeView",
          "group": "1_view@1"
        },
        {
          "command": "sessionBackup.refreshSessions",
          "when": "view == sessionBackup.sessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sessionBackup.reconnectRemote",
          "when": "view == sessionBackup.repository && viewItem == connected",
          "group": "inline"
        },
        {
          "command": "sessionBackup.openConversation",
          "when": "view == sessionBackup.sessions && viewItem =~ /^session/",
          "group": "inline"
        },
        {
          "command": "sessionBackup.openConversation",
          "when": "view == sessionBackup.repository && viewItem == changedSession",
          "group": "inline"
        },
        {
          "command": "sessionBackup.openConversation",
          "when": "view == sessionBackup.repository && viewItem == changedSession",
          "group": "1_open@1"
        },
        {
          "command": "sessionBackup.openConversation",
          "when": "view == sessionBackup.sessions && viewItem =~ /^session/",
          "group": "2_export@0"
        },
        {
          "command": "sessionBackup.exportSession",
          "when": "view == sessionBackup.sessions && viewItem =~ /^session/",
          "group": "2_export@1"
        },
        {
          "command": "sessionBackup.openSessionFile",
          "when": "view == sessionBackup.sessions && viewItem =~ /^session/",
          "group": "2_export@2"
        },
        {
          "command": "sessionBackup.includeSession",
          "when": "view == sessionBackup.sessions && viewItem =~ /Unselected$/",
          "group": "1_selection@1"
        },
        {
          "command": "sessionBackup.excludeSession",
          "when": "view == sessionBackup.sessions && viewItem =~ /Selected$/",
          "group": "1_selection@1"
        },
        {
          "command": "sessionBackup.mapProject",
          "when": "view == sessionBackup.sessions && (viewItem == unmappedProject || viewItem =~ /^projectUnmapped/)",
          "group": "inline"
        },
        {
          "command": "sessionBackup.mapProject",
          "when": "view == sessionBackup.sessions && (viewItem == unmappedProject || viewItem =~ /^projectUnmapped/)",
          "group": "1_selection@1"
        }
      ],
      "commandPalette": [
        {
          "command": "sessionBackup.debug.deleteRemoteRepository",
          "when": "config.sessionBackup.debugCommands"
        },
        {
          "command": "sessionBackup.debug.signOutGithub",
          "when": "config.sessionBackup.debugCommands"
        },
        {
          "command": "sessionBackup.debug.deleteLocalData",
          "when": "config.sessionBackup.debugCommands"
        },
        {
          "command": "sessionBackup.refreshRepository",
          "when": "false"
        },
        {
          "command": "sessionBackup.repositoryViewAsTree",
          "when": "false"
        },
        {
          "command": "sessionBackup.repositoryViewAsList",
          "when": "false"
        },
        {
          "command": "sessionBackup.resolveConflict",
          "when": "false"
        },
        {
          "command": "sessionBackup.refreshSessions",
          "when": "false"
        },
        {
          "command": "sessionBackup.previewSession",
          "when": "false"
        },
        {
          "command": "sessionBackup.openConversation",
          "when": "false"
        },
        {
          "command": "sessionBackup.exportSession",
          "when": "false"
        },
        {
          "command": "sessionBackup.openSessionFile",
          "when": "false"
        },
        {
          "command": "sessionBackup.includeSession",
          "when": "false"
        },
        {
          "command": "sessionBackup.excludeSession",
          "when": "false"
        },
        {
          "command": "sessionBackup.mapProject",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Session Backup",
      "properties": {
        "sessionBackup.repoPath": {
          "type": "string",
          "default": "",
          "description": "本地備份 Git 儲存庫路徑，留空表示 ~/.session-backup"
        },
        "sessionBackup.repoName": {
          "type": "string",
          "default": "agent-session-backup",
          "markdownDescription": "**建立或尋找**備份儲存庫時使用的名稱：尚未連接時用它在 GitHub 上比對既有的備份庫，需要新建時也用它當預設名稱。\n\n⚠️ **已經連接之後，改這個欄位不會更換儲存庫** —— 實際使用的位置記在本機備份庫的 git remote 裡。要改連到別的儲存庫，請執行 [重新連接備份儲存庫](command:sessionBackup.reconnectRemote)，或在 GitHub Backup 側欄的狀態項目上按 $(repo)。\n\n留空時使用預設值 `agent-session-backup`。"
        },
        "sessionBackup.machineId": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "此電腦在同步儲存庫中的識別名稱。留空時自動使用「主機名稱 + VS Code 安裝識別碼短雜湊」，同名主機也不會撞。此設定不會被 Settings Sync 同步到其他電腦"
        },
        "sessionBackup.autoBackupMinutes": {
          "type": "number",
          "default": 30,
          "description": "自動備份間隔（分鐘），0 表示停用"
        },
        "sessionBackup.backupOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "VSCode 啟動時自動備份一次"
        },
        "sessionBackup.maxFileSizeMB": {
          "type": "number",
          "default": 95,
          "description": "單一檔案大小上限（MB），超過者略過（GitHub 硬限制為 100 MB）"
        },
        "sessionBackup.secretScan": {
          "type": "boolean",
          "default": true,
          "description": "commit 前掃描變更檔案中的疑似 API 金鑰/憑證"
        },
        "sessionBackup.debugCommands": {
          "type": "boolean",
          "default": false,
          "order": 100,
          "markdownDescription": "在命令面板顯示除錯／重置命令（搜尋「Session Backup: [除錯]」）。也可以直接從這裡執行：\n\n- [刪除遠端備份儲存庫](command:sessionBackup.debug.deleteRemoteRepository)：永久刪除 GitHub 上的備份庫（含其他電腦的備份歷史）並解除連結\n- [登出 GitHub](command:sessionBackup.debug.signOutGithub)：讓擴充功能忘記目前的 GitHub 帳號，下次備份重新詢問\n- [刪除本機備份資料](command:sessionBackup.debug.deleteLocalData)：清除本機備份儲存庫與擴充功能狀態\n\n這些操作具破壞性且無法復原，執行前都會再次確認；`~/.claude`、`~/.codex` 裡的原始對話檔一律不會被刪除。"
        },
        "sessionBackup.selectedSessions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "（已淘汰）改用 sessionBackup.trackedSessions，啟動時自動搬移"
        },
        "sessionBackup.ignoredSessions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "deprecationMessage": "已由 sessionBackup.selectedSessions 取代（備份改為選擇制），啟動時會自動轉換並移除此設定",
          "description": "（已淘汰）永久忽略備份的 session"
        },
        "sessionBackup.sources": {
          "type": "array",
          "description": "Claude/Codex 根目錄。綠地格式只讀取 projects、sessions、archived_sessions 中的 JSONL",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          },
          "default": [
            {
              "name": "claude",
              "path": "~/.claude"
            },
            {
              "name": "codex",
              "path": "~/.codex"
            }
          ]
        },
        "sessionBackup.trackedSessions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "要追蹤（備份）的對話（白名單，建議從 Sessions 側欄的核取方塊管理）。規則分三層：`tool:claude`／`tool:codex`（整個工具，含之後新增的對話）、`claudeProject:<projects 目錄名>`（整個 Claude 專案，含之後新增的對話）、`session:<tool>:<sessionId>`（單一對話）。前綴 `-` 代表排除，例如 `-session:codex:019f44…`；判定時越具體的規則越優先（session > claudeProject > tool），所以可以勾選整個專案後再單獨排除其中一個對話。沒有任何規則涵蓋的對話不會備份、不觸發變更偵測，同步時也不會從其他電腦匯入"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test out/**/*.test.js",
    "backup:local": "npm run compile && node out/tools/rebuildLocal.js",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "prettier": "3.9.5",
    "typescript": "^5.4.0"
  }
}
